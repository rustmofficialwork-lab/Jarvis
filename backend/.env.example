# Generate a long random value; never commit real secrets.
JARVIS_CLIENT_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
JARVIS_DEVICE_TOKEN_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=replace-with-your-groq-api-key
# Ordered failover: OpenRouter first, Groq second.
JARVIS_AI_PROVIDERS=[{"name":"openrouter","base_url":"https://openrouter.ai/api/v1/chat/completions","api_key_env":"OPENROUTER_API_KEY","model":"openrouter/free"},{"name":"groq","base_url":"https://api.groq.com/openai/v1/chat/completions","api_key_env":"GROQ_API_KEY","model":"openai/gpt-oss-120b"}]
MAX_REQUEST_BYTES=12582912
UPSTREAM_TIMEOUT_SECONDS=45
MAX_UPSTREAM_RESPONSE_BYTES=2000000
# Optional: Redis/Valkey URL for atomic rate limits shared across backend instances.
# Leave unset for single-process local development only.
REDIS_URL=redis://localhost:6379/0
